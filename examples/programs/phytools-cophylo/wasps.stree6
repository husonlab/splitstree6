BEGIN TREES;
TITLE 'Input Trees';
LINK ALGORITHM = 'Taxa Filter';
[Number of trees: 2]
PROPERTIES partialTrees=yes rooted=yes;
TRANSLATE
	1 't6',
	2 'P._spec._nov._1',
	3 't7',
	4 't8',
	5 't3',
	6 't4',
	7 't1',
	8 't2',
	9 'P._nigriventris',
	10 't9',
	11 'P._rigisamos',
	12 't13',
	13 't11',
	14 't14',
	15 't10',
	16 't12',
	17 'P._near_blandus',
	18 't5',
	19 't15',
;
[TREES]
		[1] tree 'tree-1'=[&R] (1,((2,((3,4)::96,((5,6)::100,((7,8)::100,(9,(((10,11),12)::81,(((13,14)::100,15)::69,16)::100)::61))))),((17,18)::100,19)::50));
		[2] tree 'tree-2'=[&R] ((((7,8)::77,(5,(6,18))::91),((1,(3,4)::50)::99,(((10,15)::78,(13,16))::100,(12,14)::100))),19);
END; [TREES]

BEGIN ALGORITHM;
TITLE 'Input Data Filter';
LINK TREES = 'Input Trees';
NAME 'Trees Taxa Filter';
END; [ALGORITHM]

BEGIN TREES;
TITLE 'Working Trees';
LINK ALGORITHM = 'Input Data Filter';
[Number of trees: 2]
PROPERTIES partialTrees=yes rooted=yes;
TRANSLATE
	1 't6',
	2 'P._spec._nov._1',
	3 't7',
	4 't8',
	5 't3',
	6 't4',
	7 't1',
	8 't2',
	9 'P._nigriventris',
	10 't9',
	11 'P._rigisamos',
	12 't13',
	13 't11',
	14 't14',
	15 't10',
	16 't12',
	17 'P._near_blandus',
	18 't5',
	19 't15',
;
[TREES]
		[1] tree 'tree-1'=[&R] (1,((2,((3,4)::96,((5,6)::100,((7,8)::100,(9,(((10,11),12)::81,(((13,14)::100,15)::69,16)::100)::61))))),((17,18)::100,19)::50));
		[2] tree 'tree-2'=[&R] ((((7,8)::77,(5,(6,18))::91),((1,(3,4)::50)::99,(((10,15)::78,(13,16))::100,(12,14)::100))),19);
END; [TREES]

BEGIN ALGORITHM;
TITLE 'Show Trees';
LINK TREES = 'Working Trees';
NAME 'Show Trees';
OPTIONS
	View = 'Tanglegram';
END; [ALGORITHM]

BEGIN VIEW;
TITLE 'Tanglegram';
LINK ALGORITHM = 'Show Trees';
NAME 'Tanglegram';
INPUT 'TREES';
OPTIONS
	Tree1 = 1,
	Diagram1 = 'RectangularCladogram',
	Averaging1 = 'LeafAverage',
	Tree2 = 2,
	Diagram2 = 'RectangularCladogram',
	Averaging2 = 'LeafAverage',
	OptimizeTanglegramCrossings1 = 'true',
	OptimizeReticulateCrossings1 = 'true',
	OptimizeTanglegramCrossings2 = 'true',
	OptimizeReticulateCrossings2 = 'true',
	UsePQTree = 'true',
	Orientation = 'Rotate0Deg',
	HorizontalZoomFactor = 0.68301346,
	VerticalZoomFactor = 1,
	FontScaleFactor = 5.15978035,
	ShowTreeNames = 'true',
	ShowTreeInfo = 'false',
	ShowInternalLabels = 'false',
	LabelEdgesBy = 'None';
END; [VIEW]
