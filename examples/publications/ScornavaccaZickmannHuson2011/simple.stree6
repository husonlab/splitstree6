#nexus [SplitsTree6]

BEGIN SPLITSTREE6;
DIMENSIONS nDataNodes=6 nAlgorithms=3;
PROGRAM version='SplitsTree App (version 6.5.1, built 31 Jul 2025)';
WORKFLOW creationDate='1756184965443'; [Tue Aug 26 07:09:25 CEST 2025]
END; [SPLITSTREE6]

[
Methods:
Analysis was performed using SplitsTree App 6.0.0 (Huson and Bryant 2024).
The original input consisted of 6 taxa and 2 trees.
The Show Trees method was used (View=Tanglegram) so as to obtain a Tanglegram visualization (Huson 2025).

References:
Huson 2025: D.h. Huson. Tanglegrams for phylogenetic trees and networks. Manuscript in preparation (2025).
Huson and Bryant 2024: D.H. Huson and D. Bryant. The SplitsTree App: interactive analysis and visualization using phylogenetic trees and networks. Nature Methods, 2024.
]

BEGIN TAXA;
TITLE 'Input Taxa';
DIMENSIONS ntax=6;
TAXLABELS
	[1] 'a'
	[2] 'b'
	[3] 'c'
	[4] 'e'
	[5] 'd'
	[6] 'f'
;
[DISPLAYLABELS;]
[TAXINFO;]
END; [TAXA]

BEGIN ALGORITHM;
TITLE 'Taxa Filter';
NAME 'Taxa Filter';
OPTIONS
;
END; [ALGORITHM]

BEGIN TAXA;
TITLE 'Working Taxa';
LINK ALGORITHM = 'Taxa Filter';
DIMENSIONS ntax=6;
TAXLABELS
	[1] 'a'
	[2] 'b'
	[3] 'c'
	[4] 'e'
	[5] 'd'
	[6] 'f'
;
[DISPLAYLABELS;]
[TAXINFO;]
END; [TAXA]

BEGIN TREES;
TITLE 'Input Trees';
LINK ALGORITHM = 'Taxa Filter';
[Number of trees: 2]
PROPERTIES partialTrees=no rooted=yes;
TRANSLATE
	1 'a',
	2 'b',
	3 'c',
	4 'e',
	5 'd',
	6 'f',
;
[TREES]
		[1] tree 'tree-1'=[&R] (((1,2),3),((4,5),6));
		[2] tree 'tree-2'=[&R] ((2,1),(((3,6),5),4));
END; [TREES]

BEGIN ALGORITHM;
TITLE 'Input Data Filter';
LINK TREES = 'Input Trees';
NAME 'Trees Taxa Filter';
END; [ALGORITHM]

BEGIN TREES;
TITLE 'Working Trees';
LINK ALGORITHM = 'Input Data Filter';
[Number of trees: 2]
PROPERTIES partialTrees=no rooted=yes;
TRANSLATE
	1 'a',
	2 'b',
	3 'c',
	4 'e',
	5 'd',
	6 'f',
;
[TREES]
		[1] tree 'tree-1'=[&R] (((1,2),3),((4,5),6));
		[2] tree 'tree-2'=[&R] ((2,1),(((3,6),5),4));
END; [TREES]

BEGIN ALGORITHM;
TITLE 'Show Trees';
LINK TREES = 'Working Trees';
NAME 'Show Trees';
OPTIONS
	View = 'Tanglegram';
END; [ALGORITHM]

BEGIN VIEW;
TITLE 'Tanglegram';
LINK ALGORITHM = 'Show Trees';
NAME 'Tanglegram';
INPUT 'TREES';
OPTIONS
	Tree1 = 1,
	Diagram1 = 'RectangularCladogram',
	Averaging1 = 'ChildAverage',
	Tree2 = 2,
	Diagram2 = 'RectangularCladogram',
	Averaging2 = 'ChildAverage',
	OptimizeTanglegramCrossings1 = 'true',
	OptimizeReticulateCrossings1 = 'false',
	OptimizeTanglegramCrossings2 = 'true',
	OptimizeReticulateCrossings2 = 'false',
	Orientation = 'Rotate0Deg',
	HorizontalZoomFactor = 1,
	VerticalZoomFactor = 1,
	FontScaleFactor = 1,
	ShowTreeNames = 'true',
	ShowTreeInfo = 'false',
	ShowInternalLabels = 'false',
	LabelEdgesBy = 'None';
END; [VIEW]
