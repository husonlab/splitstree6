#nexus [SplitsTree6]

BEGIN SPLITSTREE6;
DIMENSIONS nDataNodes=6 nAlgorithms=3;
PROGRAM version='SplitsTree App (version 6.5.1, built 31 Jul 2025)';
WORKFLOW creationDate='1757340181949'; [Mon Sep 08 16:03:01 CEST 2025]
END; [SPLITSTREE6]

[! This example is the wasps co-phylogeny example from phyltools-cophylo, associated pairs are represented by formal taxa t1, t2, etc.
Revell, L. J. (2024) ]

[
Input:
This example is the wasps co-phylogeny example from phyltools-cophylo, associated pairs are represented by formal taxa t1, t2, etc.
Revell, L. J. (2024)

Methods:
Analysis was performed using SplitsTree App 6.0.0 (Huson and Bryant 2024).
The original input consisted of 19 taxa and 2 trees, partial.
The Show Trees method was used (View=Tanglegram) so as to obtain a Tanglegram visualization (Huson 2025).

References:
Huson 2025: D.H. Huson. Displacement-Optimized Tanglegrams for Trees and Networks. Manuscript in preparation (2025).
Huson and Bryant 2024: D.H. Huson and D. Bryant. The SplitsTree App: interactive analysis and visualization using phylogenetic trees and networks. Nature Methods, 2024.
]

BEGIN TAXA;
TITLE 'Input Taxa';
DIMENSIONS ntax=19;
TAXLABELS
	[1] 't6'
	[2] 'P._spec._nov._1'
	[3] 't7'
	[4] 't8'
	[5] 't3'
	[6] 't4'
	[7] 't1'
	[8] 't2'
	[9] 'P._nigriventris'
	[10] 't9'
	[11] 'P._rigisamos'
	[12] 't13'
	[13] 't11'
	[14] 't14'
	[15] 't10'
	[16] 't12'
	[17] 'P._near_blandus'
	[18] 't5'
	[19] 't15'
;
DISPLAYLABELS
	[1] 't6 P. regalis = S. 8'
	[2] 'P. spec.  nov. 1'
	[3] 't7 P. schizodontes = S. 9'
	[4] 't8 P. nitens = S. 10'
	[5] 't3 P. plebejus = S. 14'
	[6] 't4 P. rieki = S. 12'
	[7] 't1 P. xanthocephalus = S. 2'
	[8] 't2 P. greenwood = S. 4'
	[9] 'P._nigriventris'
	[10] 't9 P. imperialis = S. 15'
	[11] 'P._rigisamos'
	[12] 't13 P. macrocainus = S. 5'
	[13] 't11 P. astrabocheilus = S. 7'
	[14] 't14 P. cuneatus = S.3'
	[15] 't10 P. athysanus = S. 1'
	[16] 't12 P. proximus = S.6'
	[17] 'P._near_blandus'
	[18] 't5 P. blandus  = S. 11'
	[19] 't15 P. froggatti   = S. australis'
;
[TAXINFO;]
END; [TAXA]

BEGIN ALGORITHM;
TITLE 'Taxa Filter';
NAME 'Taxa Filter';
OPTIONS
;
END; [ALGORITHM]

BEGIN TAXA;
TITLE 'Working Taxa';
LINK ALGORITHM = 'Taxa Filter';
DIMENSIONS ntax=19;
TAXLABELS
	[1] 't6'
	[2] 'P._spec._nov._1'
	[3] 't7'
	[4] 't8'
	[5] 't3'
	[6] 't4'
	[7] 't1'
	[8] 't2'
	[9] 'P._nigriventris'
	[10] 't9'
	[11] 'P._rigisamos'
	[12] 't13'
	[13] 't11'
	[14] 't14'
	[15] 't10'
	[16] 't12'
	[17] 'P._near_blandus'
	[18] 't5'
	[19] 't15'
;
DISPLAYLABELS
	[1] 't6 P. regalis = S. 8'
	[2] 'P. spec.  nov. 1'
	[3] 't7 P. schizodontes = S. 9'
	[4] 't8 P. nitens = S. 10'
	[5] 't3 P. plebejus = S. 14'
	[6] 't4 P. rieki = S. 12'
	[7] 't1 P. xanthocephalus = S. 2'
	[8] 't2 P. greenwood = S. 4'
	[9] 'P._nigriventris'
	[10] 't9 P. imperialis = S. 15'
	[11] 'P._rigisamos'
	[12] 't13 P. macrocainus = S. 5'
	[13] 't11 P. astrabocheilus = S. 7'
	[14] 't14 P. cuneatus = S.3'
	[15] 't10 P. athysanus = S. 1'
